
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap');

:root{
  --bg:#090909;
  --panel:#121212;
  --panel2:#171717;
  --line:rgba(229,188,48,.18);
  --gold:#e5bb2f;
  --gold2:#ffc928;
  --red:#ff3038;
  --text:#f5f3ed;
  --muted:#8e8b86;
  --green:#19a95a;
  --shadow:0 18px 50px rgba(0,0,0,.45);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:radial-gradient(circle at 50% -10%,#2a1e05 0,#0b0b0b 32%,#070707 100%);
  color:var(--text);font-family:Inter,Arial,sans-serif;line-height:1.5;
}
a{text-decoration:none;color:inherit}
button,input,textarea{font:inherit}
button{cursor:pointer}
.container{width:min(1180px,calc(100% - 32px));margin:auto}
.topbar{
  position:sticky;top:0;z-index:50;background:rgba(8,8,8,.94);
  backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,.07)
}
.nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:12px}
.logo{
  width:42px;height:42px;border-radius:10px;display:grid;place-items:center;
  background:linear-gradient(135deg,#ffb52a,#e7cc31);color:#111;font-weight:900
}
.brand h1{font-size:15px;letter-spacing:2px;font-weight:900}
.brand small{display:block;color:#b79727;font-size:9px;letter-spacing:3px;margin-top:2px}
.navlinks{display:flex;gap:24px;color:#aaa;font-size:12px;font-weight:700}
.navlinks a:hover{color:#fff}
.btn{
  border:0;border-radius:999px;padding:13px 20px;font-size:11px;
  font-weight:900;letter-spacing:1.2px;display:inline-flex;align-items:center;
  justify-content:center;gap:8px;transition:.2s
}
.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}
.btn.gold{background:linear-gradient(90deg,#e5bd32,#f0c832);color:#111}
.btn.red{background:linear-gradient(90deg,#ff2d32,#ff7b21);color:#fff}
.btn.dark{background:#141414;border:1px solid #3a362c;color:#eee}

.hero{
  min-height:620px;margin-top:28px;border:1px solid var(--line);border-radius:28px;
  overflow:hidden;position:relative;display:flex;align-items:flex-end;
  background:
    linear-gradient(90deg,rgba(0,0,0,.9) 0%,rgba(0,0,0,.55) 46%,rgba(0,0,0,.18)),
    url('https://images.unsplash.com/photo-1503736334956-4c8f8e92946d?auto=format&fit=crop&w=1800&q=85') center/cover;
  box-shadow:var(--shadow)
}
.hero:after{content:"";position:absolute;inset:auto 0 0;height:48%;background:linear-gradient(transparent,#070707)}
.hero-content{position:relative;z-index:2;padding:60px 52px;max-width:760px}
.kicker{color:#e7bf32;letter-spacing:3px;font-size:11px;font-weight:800;margin-bottom:15px}
.hero h2{font-size:clamp(40px,7vw,78px);line-height:.95;font-weight:900;letter-spacing:-3px;text-transform:uppercase}
.hero h2 span{color:var(--gold)}
.hero p{max-width:600px;color:#c4c1bc;margin:22px 0;font-size:15px}
.actions{display:flex;gap:12px;flex-wrap:wrap}

.poster{
  margin:34px 0;border-radius:24px;min-height:470px;overflow:hidden;position:relative;
  border:1px solid rgba(255,255,255,.08);
  background:linear-gradient(0deg,rgba(0,0,0,.9),transparent 60%),
  url('https://images.unsplash.com/photo-1493238792000-8113da705763?auto=format&fit=crop&w=1800&q=85') center/cover;
}
.poster-content{position:absolute;left:32px;right:32px;bottom:30px}
.poster h3{font-size:clamp(28px,5vw,58px);font-weight:900;text-transform:uppercase}
.poster p{color:#aaa;max-width:700px}

.section{padding:78px 0}
.section-head{margin-bottom:28px}
.eyebrow{font-size:10px;letter-spacing:3px;color:#b9972a;font-weight:900}
.section h2{font-size:clamp(30px,5vw,48px);line-height:1;margin-top:8px}
.section-head p{color:#777;margin-top:12px;max-width:700px}

.feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.feature{
  min-height:185px;padding:25px;border:1px solid rgba(255,255,255,.08);
  border-radius:20px;background:linear-gradient(145deg,#141414,#0d0d0d);
  position:relative;overflow:hidden
}
.feature:before{content:"";position:absolute;inset:auto -40px -60px auto;width:150px;height:150px;background:rgba(229,187,47,.05);border-radius:50%}
.icon{width:42px;height:42px;border-radius:12px;background:#251f0e;border:1px solid #6b571b;display:grid;place-items:center;margin-bottom:22px;font-size:20px}
.feature h3{font-size:17px;margin-bottom:8px}
.feature p{color:#7f7b77;font-size:12px;max-width:520px}

.rankings{border:1px solid rgba(229,188,48,.16);border-radius:22px;overflow:hidden;background:#101010}
.rank{display:grid;grid-template-columns:70px 1fr 150px 150px;gap:18px;padding:23px;border-bottom:1px solid rgba(255,255,255,.05);align-items:center}
.rank:last-child{border:0}
.ranknum{font-weight:900;color:#d7b52e}
.player{font-weight:800}.player small,.rank small{display:block;color:#6d6a65;font-size:10px;margin-top:3px}
.money{color:#e6c239;font-weight:900}
.badge{border-radius:999px;background:#26231b;border:1px solid #4b401e;padding:6px 10px;color:#c8b87a;font-size:9px;font-weight:800;text-align:center}

.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.info{padding:22px;border:1px solid rgba(255,255,255,.08);background:#121212;border-radius:18px}
.info b{display:block;color:#fff;margin-bottom:7px}.info span{font-size:12px;color:#777}

.contact{background:#111;border:1px solid rgba(255,255,255,.07);border-radius:22px;padding:30px}
.form{display:grid;gap:13px;margin-top:20px}
.field{background:#050505;border:1px solid #262626;color:#fff;border-radius:10px;padding:15px;outline:none;width:100%}
textarea.field{min-height:140px;resize:vertical}

footer{border-top:1px solid rgba(255,255,255,.06);padding:55px 0 30px;background:#050505}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:35px}
footer h4{font-size:12px;letter-spacing:1px;margin-bottom:14px}
footer p,footer a{color:#686661;font-size:11px;display:block;margin:8px 0}
.copy{margin-top:40px;padding-top:20px;border-top:1px solid #161616;color:#555;font-size:10px}

.float-support{
 position:fixed;right:20px;bottom:22px;z-index:60;background:linear-gradient(135deg,#f3c72e,#ff8d21);
 color:#111;border-radius:999px;padding:15px 20px;font-size:10px;font-weight:900;
 box-shadow:0 0 30px rgba(237,190,42,.25)
}

/* MARKET */
.store-hero{min-height:500px;margin-top:28px;border-radius:25px;border:1px solid var(--line);position:relative;overflow:hidden;
 background:linear-gradient(90deg,rgba(0,0,0,.94),rgba(0,0,0,.35)),
 url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1800&q=85') center/cover}
.store-hero .hero-content{padding:50px 42px}
.store-hero h2{font-size:clamp(38px,6vw,68px);line-height:.96}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0}
.stat{padding:22px;border:1px solid rgba(229,188,48,.15);background:#131313;border-radius:17px}
.stat strong{display:block;font-size:27px}.stat span{color:#777;font-size:11px;letter-spacing:2px}
.payments{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:16px;border:1px solid rgba(255,255,255,.07);border-radius:17px;background:#121212}
.payments b{font-size:10px;letter-spacing:1px;margin-right:8px}.pay{padding:8px 12px;background:#1c1c1c;border:1px solid #2d2d2d;border-radius:999px;color:#888;font-size:10px}
.pay.active{background:#e4bb2f;color:#111;font-weight:900}
.rate{margin:38px 0 25px;padding:20px 23px;border-radius:17px;border:1px solid #69551b;background:linear-gradient(90deg,#2a2110,#17130b);display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap}
.rate strong{font-size:14px}.rate span{background:#e5bd32;color:#111;padding:8px 13px;border-radius:999px;font-size:10px;font-weight:900}
.coin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.coin-card,.market-card,.property,.donor{border:1px solid rgba(255,255,255,.08);border-radius:18px;background:#131313;overflow:hidden}
.coin-card{padding:25px;position:relative}.coin-card.popular{border-color:#8d711d;box-shadow:0 0 25px rgba(220,180,40,.06)}
.coin-icon{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#ffbd20,#ff3b30);display:grid;place-items:center;color:#111;font-size:10px;font-weight:900;margin-bottom:17px}
.coin-card h3{font-size:14px}.coin-card .amount{font-size:27px;color:#e4bc31;font-weight:900;margin:12px 0}.price{font-size:11px;color:#777}
.card-actions{display:flex;gap:8px;margin-top:22px}.card-actions .btn{flex:1;padding:12px 10px}.mini{padding:12px 15px!important}

.market-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.market-card img{width:100%;height:250px;object-fit:cover;display:block}
.market-info{padding:17px}.market-top{display:flex;justify-content:space-between;gap:10px}.market-top h3{font-size:14px}.gc{color:#e4bd32;font-weight:900}.desc{margin:10px 0;padding:12px;background:#090909;border-radius:10px;color:#777;font-size:10px}
.property-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.property{padding:20px}.property h3{font-size:13px}.property .gc{margin:8px 0 13px;display:block}.property p{font-size:10px;color:#777;margin-bottom:16px}
.donor-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.donor{padding:25px;position:relative}.donor h3{font-size:13px}.donor .amount{font-size:24px;color:#e5bc30;font-weight:900;margin:8px 0}.donor ul{list-style:none;color:#777;font-size:11px;line-height:2}.donor li:before{content:"✓";color:#dcb62d;margin-right:8px}
@media(max-width:800px){
 .container{width:min(100% - 24px,1180px)}.nav{height:68px}.navlinks{display:none}
 .hero{min-height:540px;border-radius:20px}.hero-content{padding:35px 22px}.poster{min-height:390px}.poster-content{left:22px;right:22px}
 .feature-grid,.market-grid{grid-template-columns:1fr}.rank{grid-template-columns:45px 1fr 95px;gap:10px}.rank .badge{display:none}
 .stats{grid-template-columns:repeat(2,1fr)}.coin-grid{grid-template-columns:repeat(2,1fr)}
 .property-grid{grid-template-columns:1fr}.donor-grid{grid-template-columns:1fr}.info-grid{grid-template-columns:1fr}
 .footer-grid{grid-template-columns:1fr 1fr}.market-card img{height:210px}
}
@media(max-width:480px){
 .coin-grid{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr}.hero h2{letter-spacing:-2px}
 .store-hero{min-height:590px}.store-hero .hero-content{padding:30px 22px}.stats{gap:9px}.stat{padding:16px}
 .float-support{right:12px;bottom:14px}
}
